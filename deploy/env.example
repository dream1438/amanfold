# Copy to .env on the server (chmod 600). Never commit .env.

# Hostnames. Point both at the server in DNS before the first start.
API_DOMAIN=api.amanfold.com
SITE_DOMAIN=amanfold.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.com

# Email for sign-up and recovery codes. TLS is required.
# Resend:   smtps://resend:<API key>@smtp.resend.com:465
# Postmark: smtp://<server token>:<server token>@smtp.postmarkapp.com:587?tls=required
AMANFOLD_SMTP_URL=
AMANFOLD_MAIL_FROM=Amanfold <no-reply@amanfold.com>

# Websites allowed to call the API from a browser (waitlist form).
AMANFOLD_ALLOWED_ORIGINS=https://amanfold.com,https://www.amanfold.com

# Off-site backups (restic). The restic password is generated by
# scripts/install.sh into secrets/restic-password: keep a copy offline.
# Backblaze B2 (S3 API):
RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/amanfold-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Or a Hetzner Storage Box over SFTP (port 23), no keys needed above:
# RESTIC_REPOSITORY=sftp://u123456@u123456.your-storagebox.de:23//home/amanfold
# Optional: healthchecks.io ping URL; you get an email if backups stop.
BACKUP_PING_URL=

# Image to run. Pin a tag (e.g. sha-abc1234) to control upgrades.
AMANFOLD_IMAGE=ghcr.io/dream1438/amanfold-server:latest
