<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device through cloud backup or device transfer: the
     vault syncs through the Amanfold server, and the Keystore keys that
     protect local files cannot move anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
